{
    "layer": "top",
    "position": "top",
    // no fixed height: the pill padding in style.css decides it.
    "spacing": 4,

    // gap between the bar and the screen edges -- the floating look
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": [
        "ext/workspaces",
        "hyprland/submap",
        "custom/sep",
        "clock"
    ],

    "modules-center": [
        "cpu",
        "temperature",
        "memory",
        "disk",
        "network#upspeed",
        "network#downspeed",
        "battery"
    ],

    "modules-right": [
        "network#wired",
        "network#wireless",
        "bluetooth",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "hyprland/language"
        // "custom/sep",
        // "tray"
    ],

    // ---- left ------------------------------------------------------------
    // NOT "hyprland/workspaces": that module's click handler is hardcoded in
    // waybar's C++ to send `dispatch workspace <id>` over Hyprland's IPC socket,
    // and this Hyprland runs the *Lua* config, where the socket wraps whatever it
    // receives as `return hl.dispatch(<arg>)` and evaluates it as Lua. The bare
    // string is a syntax error -- verified by sending it to .socket.sock by hand:
    //
    //   error: [string "return hl.dispatch(workspace 2)"]:1: ')' expected near '2'
    //
    // so clicking a pill silently did nothing and no config key could fix it.
    //
    // "ext/workspaces" speaks ext-workspace-v1 instead (Hyprland 0.56 advertises
    // ext_workspace_manager_v1), so "on-click": "activate" is a protocol request,
    // not a dispatch string -- it never touches the Lua parser. Same #workspaces /
    // button.active CSS selectors, so style.css needs no change.
    //
    // Trade-offs vs. the hyprland module: no persistent-workspaces (occupied-only
    // here, which is what we want anyway) and no `visible` class, so the
    // "#workspaces button.visible" rule in style.css is now inert -- ext exposes
    // `hidden` instead. {name} rather than {id}: ext's {id} is the protocol's
    // opaque handle id, {name} is Hyprland's "1".."10".
    //
    // Also still unsolved from the hyprland module: app-icon-per-workspace. It was
    // attempted two ways there and neither rendered on waybar 0.15.0 -- `{windows}`
    // + window-rewrite produced empty output, and `workspace-taskbar` drew nothing.
    "ext/workspaces": {
        "format": "{name}",
        "sort-by-name": true,
        // The whole point of the module swap -- protocol activate, not IPC.
        "on-click": "activate",
        // Scrolling still goes through hyprctl, because "next *occupied*
        // workspace, wrapping" is a Hyprland concept that ext-workspace-v1 has no
        // request for. This is the Lua form (`hl.dsp.focus{ workspace = ... }`,
        // the same one hypr/hyprland.lua:347-351 binds to SUPER+Tab and
        // SUPER+wheel); the classic `hyprctl dispatch workspace e+1` dies with the
        // Lua syntax error above. Lua single quotes keep the JSON escape-free.
        "on-scroll-up": "hyprctl dispatch \"hl.dsp.focus({workspace='e+1'})\"",
        "on-scroll-down": "hyprctl dispatch \"hl.dsp.focus({workspace='e-1'})\"",
        // Deliberately no "smooth-scrolling-threshold": under Wayland a mouse wheel
        // also arrives as GDK_SCROLL_SMOOTH, so a threshold throttles the wheel too
        // -- at 4 it cost several notches per switch. Unset = 1 notch = 1 workspace.
        // Uncomment and tune upward on a touchpad, where one flick will otherwise
        // fire several switches.
        // "smooth-scrolling-threshold": 1.0,
    },

    // i3 had no mode indicator; the resize submap gets one for free here.
    "hyprland/submap": {
        "format": "  {}",
        "tooltip": false
    },

    "custom/sep": {
        "format": "|",
        "tooltip": false
    },

    "clock": {
        "format": "  {:%A, %d %B %H:%M}",
        "format-alt": "  {:%A, %d %B %Y %H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    // ---- center ----------------------------------------------------------
    "cpu": {
        "interval": 1,
        "format": "  {usage}%"
    },

    // polybar pointed at thermal_zone1, which on this machine is "INT3400 Thermal"
    // -- a thermal policy device, not a processor sensor.
    //
    // NOT "hwmon-path": /sys/class/hwmon/hwmonN is assigned in module probe
    // order and moves across boots (nine devices compete for it here, incl.
    // iwlwifi and nvme). hwmon-path-abs points at the coretemp device itself,
    // so the index is irrelevant. temp1_label == "Package id 0".
    "temperature": {
        "interval": 2,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "  {temperatureC}°C",
        "format-critical": "  {temperatureC}°C"
    },

    "memory": {
        "interval": 1,
        "format": "󰍛  {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G  ({percentage}%)"
    },

    // polybar: filesystem mount-0 = /, label = free space
    "disk": {
        "interval": 30,
        "path": "/",
        "format": "  {free}"
    },

    // No "interface" -- waybar auto-detects the default-route interface, so
    // this tracks whichever connection is actually active (wifi on a laptop,
    // ethernet here) instead of a hardcoded, machine-specific device name
    // (this box is enp6s0/wlp5s0, a laptop is more like eno2/wlo1 -- neither
    // name is portable between them).
    "network#upspeed": {
        "interval": 1,
        "format": " {bandwidthUpBytes}",
        "format-disconnected": " 0B",
        "tooltip": false
    },

    "network#downspeed": {
        "interval": 1,
        "format": " {bandwidthDownBytes}",
        "format-disconnected": " 0B",
        "tooltip": false
    },

    // polybar: battery BAT0 / adapter AC / full-at 99
    "battery": {
        "bat": "BAT0",
        "adapter": "AC",
        "interval": 2,
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}  {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-full": "  Full",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}  ({power}W)"
    },

    // ---- right -----------------------------------------------------------
    // Wildcards (waybar's "interface" accepts them), not exact device names:
    // predictable network interface names differ per machine (this box is
    // enp6s0/wlp5s0, a laptop is more like eno2/wlo1), so an exact name here
    // broke silently on any box but the one it was written on.
    "network#wired": {
        "interface": "en*",
        "interval": 2,
        "format-ethernet": " ",
        "format-disconnected": "",
        "format-disabled": "",
        "format-linked": " ",
        "format-wifi": "",
        "tooltip-format": "{ifname}  {ipaddr}"
    },

    "network#wireless": {
        "interface": "wl*",
        "interval": 2,
        "format-wifi": "  {essid}",
        "format-disconnected": "󰖪 ",
        "format-ethernet": "",
        "format-linked": "",
        "tooltip-format-wifi": "{essid}  {signalStrength}%  {ipaddr}"
    },

    // Native DBus module -- replaces the old custom/bluetooth + scripts/bluetooth.sh,
    // which polled `rofi-bluetooth --status` every 5s. This is event-driven and adds
    // per-device battery. rofi-bluetooth stays as the click menu.
    //
    // Icons are the Nerd Font Material Design set: it has a real crossed-out glyph
    // (U+F00B2 󰂲) for "off", which the FontAwesome pair used before did not -- every
    // state drew the same  and only the CSS colour changed.
    //
    // The label carries the *displayed* device's alias ({device_alias} = the one
    // picked by format-device-preference, else the last connected). The module has
    // no bar-label enumerator -- {device_enumerate} is tooltip-only -- so with 2+
    // devices connected the bar shows one name and the tooltip lists them all.
    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-no-controller": "󰂲",
        "format-on": "󰂯",
        "format-connected": "󰂱  {device_alias}",
        "format-connected-battery": "󰂱  {device_alias}",
        // caps the whole label -- icon + two spaces + ~14 chars of name; long aliases
        // ("Bose Mini II SE SoundLink") get cut here and stay whole in the tooltip.
        "max-length": 20,
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
        "on-click": "~/dotfiles/rofi-bluetooth/rofi-bluetooth &"
    },

    // polybar rendered an 11-cell bar; waybar has no equivalent, so ramp + percentage.
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  Muted",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "scroll-step": 2,
        "on-click": "pavucontrol"
    },

    // polybar internal/xkeyboard -> the us,ru layouts now come from hyprland's input{}
    "hyprland/language": {
        "format": "  {short}",
        "tooltip": false
    }
}
