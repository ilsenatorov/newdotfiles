{
    "layer": "top",
    "position": "top",
    // no fixed height: the pill padding in style.css decides it.
    "spacing": 4,

    // gap between the bar and the screen edges -- the floating look
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,

    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap",
        "custom/sep",
        "clock"
    ],

    "modules-center": [
        "cpu",
        "temperature",
        "memory",
        "disk",
        "network#upspeed",
        "network#downspeed",
        "battery"
    ],

    "modules-right": [
        "network#wired",
        "network#wireless",
        "bluetooth",
        "custom/sep",
        "pulseaudio",
        "custom/sep",
        "hyprland/language"
        // "custom/sep",
        // "tray"
    ],

    // ---- left ------------------------------------------------------------
    // NOTE: app-icon-per-workspace was attempted two ways and neither renders on
    // waybar 0.15.0 here -- `{windows}` + window-rewrite produces empty output,
    // and `workspace-taskbar` draws nothing despite the config parsing cleanly
    // and both windows being present. Left out rather than shipped dead.
    // What IS working below: correct `sort-by` (was the ignored `sort-by-number`)
    // and persistent 1-5 so the workspace row stops reflowing.
    "hyprland/workspaces": {
        "format": "{id}",
        "sort-by": "number",
        // "persistent-workspaces": { "*": [1, 2, 3, 4, 5] }
    },

    // i3 had no mode indicator; the resize submap gets one for free here.
    "hyprland/submap": {
        "format": "  {}",
        "tooltip": false
    },

    "custom/sep": {
        "format": "|",
        "tooltip": false
    },

    "clock": {
        "format": "  {:%A, %d %B %H:%M}",
        "format-alt": "  {:%A, %d %B %Y %H:%M:%S}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    // ---- center ----------------------------------------------------------
    "cpu": {
        "interval": 1,
        "format": "  {usage}%"
    },

    // polybar pointed at thermal_zone1, which on this machine is "INT3400 Thermal"
    // -- a thermal policy device, not a processor sensor.
    //
    // NOT "hwmon-path": /sys/class/hwmon/hwmonN is assigned in module probe
    // order and moves across boots (nine devices compete for it here, incl.
    // iwlwifi and nvme). hwmon-path-abs points at the coretemp device itself,
    // so the index is irrelevant. temp1_label == "Package id 0".
    "temperature": {
        "interval": 2,
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "  {temperatureC}°C",
        "format-critical": "  {temperatureC}°C"
    },

    "memory": {
        "interval": 1,
        "format": "󰍛  {used:0.1f}G",
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G  ({percentage}%)"
    },

    // polybar: filesystem mount-0 = /, label = free space
    "disk": {
        "interval": 30,
        "path": "/",
        "format": "  {free}"
    },

    "network#upspeed": {
        "interface": "wlo1",
        "interval": 1,
        "format": " {bandwidthUpBytes}",
        "format-disconnected": " 0B",
        "tooltip": false
    },

    "network#downspeed": {
        "interface": "wlo1",
        "interval": 1,
        "format": " {bandwidthDownBytes}",
        "format-disconnected": " 0B",
        "tooltip": false
    },

    // polybar: battery BAT0 / adapter AC / full-at 99
    "battery": {
        "bat": "BAT0",
        "adapter": "AC",
        "interval": 2,
        "states": { "warning": 30, "critical": 15 },
        "format": "{icon}  {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-full": "  Full",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}  ({power}W)"
    },

    // ---- right -----------------------------------------------------------
    "network#wired": {
        "interface": "eno2",
        "interval": 2,
        "format-ethernet": " ",
        "format-disconnected": "",
        "format-disabled": "",
        "format-linked": " ",
        "format-wifi": "",
        "tooltip-format": "{ifname}  {ipaddr}"
    },

    "network#wireless": {
        "interface": "wlo1",
        "interval": 2,
        "format-wifi": "  {essid}",
        "format-disconnected": "󰖪 ",
        "format-ethernet": "",
        "format-linked": "",
        "tooltip-format-wifi": "{essid}  {signalStrength}%  {ipaddr}"
    },

    // Native DBus module -- replaces the old custom/bluetooth + scripts/bluetooth.sh,
    // which polled `rofi-bluetooth --status` every 5s. This is event-driven and adds
    // per-device battery. rofi-bluetooth stays as the click menu.
    "bluetooth": {
        "format": "",
        "format-disabled": "",
        "format-off": "",
        "format-connected": "  {num_connections}",
        "format-connected-battery": "  {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
        "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_battery_percentage}%",
        "on-click": "~/dotfiles/rofi-bluetooth/rofi-bluetooth &"
    },

    // polybar rendered an 11-cell bar; waybar has no equivalent, so ramp + percentage.
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "  Muted",
        "format-icons": {
            "headphone": "",
            "headset": "",
            "default": ["", "", ""]
        },
        "scroll-step": 2,
        "on-click": "pavucontrol"
    },

    // polybar internal/xkeyboard -> the us,ru layouts now come from hyprland's input{}
    "hyprland/language": {
        "format": "  {short}",
        "tooltip": false
    }
}
