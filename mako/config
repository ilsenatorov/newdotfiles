# Notifications styled to match the waybar pills (waybar/style.css).
# mako had no config at all before this -- it ran on stock light-grey defaults
# against a #141C21 / #4DD0E1 desktop.

# Accent from the wallpaper (generated by matugen). Any border-color set after
# this include overrides it.
include=~/.config/mako/colors

font=Iosevka Nerd Font 11
background-color=#141C21d9
text-color=#93A1A1

# waybar: border-radius 12px, padding 4px 12px, margin-top 6 / margin-right 8
border-size=2
border-radius=12
padding=10,14
margin=6
default-timeout=6000
ignore-timeout=0

width=380
height=140
max-visible=5
anchor=top-right
layer=overlay

markup=1
actions=1
icons=1
max-icon-size=48

on-button-left=dismiss
on-button-right=dismiss-all
on-button-middle=invoke-default-action

[urgency=low]
border-color=#3C4449
text-color=#6D8895
default-timeout=4000

[urgency=normal]
# border-color intentionally unset -- inherits the generated accent

[urgency=critical]
border-color=#EC7875
text-color=#EC7875
default-timeout=0

[category=screenshot]
default-timeout=3000
