.*
!.gitignore
!.zshrc
!.github
!.github/**
# generated by the graphify tool, not configuration
graphify-out/

# Generated by matugen from the wallpaper -- see matugen/config.toml and
# hypr/scripts/set-wallpaper.sh. Machine state, never configuration. A
# committed snapshot for a fresh clone lives in matugen/defaults/.
/hypr/colors.conf
/hypr/colors.lua
/hypr/wallpaper.conf
/kitty/colors.conf
/quickshell/Colors.qml
/gtk-3.0/colors.css
/gtk-4.0/colors.css
/starship/colors.toml
/starship/starship.toml
/nvim/colors.lua

# Per-machine identity (user.name/email, anything box-specific). Generated
# once by install.sh via write_local(), same contract as local.conf/local.lua.
/git/config.local

# lazy.nvim's own state, not configuration.
/nvim/lazy-lock.json.bak
