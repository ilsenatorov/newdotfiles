
@import "colors.rasi"

* {
  al:   #00000000;
  /* not fully opaque: hypr/hyprland.lua carries a layer rule blurring the
     "rofi" namespace, the same treatment the quickshell bar and
     notifications get. */
  bg:   #141C21E6;
  bga:  #1E262BFF;
  fg:   #93A1A1FF;
  se:   #1E262BFF;   /* selection surface, was #333333 (off-palette) */
  /* @sf is the wallpaper-tinted surface from matugen (colors.rasi) */
}

window {
    transparency:                   "real";
    background-color:               @bg;
    text-color:                     @fg;
	border:							0px;
	border-color:					@ac;
    border-radius:                  12px;
	width:							@width;
    /* was north west with zero offsets, which slammed the launcher into the
       top-left corner underneath the floating bar. Centred instead, lifted
       slightly above the optical centre. */
    location:                       center;
    anchor:                         center;
    x-offset:                       0;
    y-offset:                       -60;
    padding:                        8px;
    cycle:                          true;
}

prompt {
    enabled: 						false;
	padding: 						0 0 0 0 ;
	background-color: 				@al;
	text-color: 					@fg;
    expand: false;
}

entry {
    background-color:               @al;
    text-color:                     @fg;
    placeholder-color:              @fg;
    expand:                         false;
    placeholder:                    @placeholder;
	padding: 						0 0 0 5px;
    blink:                          true;
}

inputbar {
	children: 						[prompt, entry];
    /* was @bg with square corners inside a 12px-radius window */
    background-color:               @se;
    text-color:                     @fg;
    expand:                         false;
	border:							0% 0% 0% 0%;
    border-radius:                  12px;
	border-color:					@ac;
    padding:                        10px 14px;
    margin:                         4px 4px 8px 4px;
}

listview {
    background-color:               @al;
    padding:                        1px;
    columns:                        @cols;
    spacing:                        2px;
    lines:                          15;
    layout:                         vertical;
    dynamic:                        true;
    cycle:                          true;
    fixed-height:                   false;
    expand:                         true;
}

mainbox {
    background-color:               @al;
	border-color:					@ac;
    children:                       [ inputbar, listview ];
    spacing:                       	0%;
    padding:                        0%;
}

element {
    background-color:               @al;
    text-color:                     @fg;
    orientation:                    horizontal;
    border-radius:                  12px;
    padding:                        10 10 10 10;
}

element-icon {
    background-color: 				inherit;
    text-color:       				inherit;
    size:                           32px;
    border:                         0px;
}

element-text {
    background-color: 				@al;
    text-color:       				inherit;
    expand:                         true;
}

element selected {
    /* wallpaper-tinted surface + the accent bar down the left edge */
    background-color:               @sf;
    text-color:                     @ac;
	border:							0px 0px 0px 3px;
    border-radius:                  12px;
    border-color:                  	@ac;
}
